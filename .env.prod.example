# ===================================================
# InfraSmart - 프로덕션 환경변수
# 이 파일을 .env.prod 로 복사 후 값을 채워주세요
# cp .env.prod.example .env.prod
# ===================================================

# ── 앱 설정 ──────────────────────────────────────
APP_NAME=InfraSmart
APP_VERSION=0.1.0
DEBUG=false

# ── 백엔드 공개 URL (파일 URL 생성에 사용) ────────
# 도메인 없이 시작: http://[EC2_PUBLIC_IP]
# 도메인 설정 후: https://api.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ── CORS 허용 출처 ────────────────────────────────
# Vercel 도메인 및 커스텀 도메인
# 여러 개: https://your-app.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# ── 데이터베이스 ──────────────────────────────────
POSTGRES_DB=infrasmart
POSTGRES_USER=infrasmart
# 강력한 비밀번호로 변경 필수!
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Redis ─────────────────────────────────────────
# Redis 비밀번호 (공백이면 인증 없음 - 프로덕션에서는 필수)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ── JWT 인증 ──────────────────────────────────────
# 32자 이상의 랜덤 문자열 (openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── 파일 스토리지 ─────────────────────────────────
# 초기: local (EC2 EBS) | 이후: s3 (Naver Cloud Object Storage 등)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# S3 호환 오브젝트 스토리지 (STORAGE_TYPE=s3 시 사용)
# NCLOUD_ACCESS_KEY=
# NCLOUD_SECRET_KEY=
# NCLOUD_REGION=kr-standard
# NCLOUD_BUCKET=infrasmart-files

# ── AI 서비스 ─────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── 지오펜스 ──────────────────────────────────────
DEFAULT_GEOFENCE_RADIUS_M=500
GPS_SPOOF_DETECTION=true

# ── 어드민 계정 생성 키 ───────────────────────────
# 최초 어드민 계정 생성에만 사용, 이후 빈 값으로 비활성화
ADMIN_CREATION_KEY=CHANGE_ME_ADMIN_KEY
