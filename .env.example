# ===========================
# InfraSmart - 환경변수 예시
# .env.example을 복사해서 .env로 사용
# ===========================

# ── 데이터베이스 ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=infrasmart
POSTGRES_USER=infrasmart
POSTGRES_PASSWORD=changeme_secure_password

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT 인증 ─────────────────────────────────
JWT_SECRET_KEY=changeme_very_long_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── 파일 스토리지 ─────────────────────────────
# 로컬 개발: local | 운영: s3
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# NCloud Object Storage (운영 시 사용)
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=
NCLOUD_REGION=kr-standard
NCLOUD_BUCKET=infrasmart-files

# ── AI 서비스 (Phase 2) ───────────────────────
OPENAI_API_KEY=

# ── 앱 설정 ──────────────────────────────────
APP_NAME=InfraSmart
APP_VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── 지오펜스 기본값 ───────────────────────────
DEFAULT_GEOFENCE_RADIUS_M=500
GPS_SPOOF_DETECTION=true
